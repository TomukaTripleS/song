{
  "info": {
    "name": "Song API — CRUD",
    "description": "Запустіть сервер і виконайте всю колекцію зверху вниз через Collection Runner. ID зберігаються автоматично. Колекція створює власні дані й видаляє їх наприкінці. Приклад 409 виконується до видалення пісні. Для повторного запуску використовується унікальне ім’я. Для демонстрації фронтенду можна зупинитися після створення пісні.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "artist_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "song_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "existing_artist_name",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Створити виконавця",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/artists/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman {{$guid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"artist_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
