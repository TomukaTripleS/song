      "name": "Авторизація",
      "item": [
        {
          "name": "Реєстрація: помилки полів — 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/register/",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"\",\n  \"email\": \"invalid\",\n  \"password\": \"short\",\n  \"password_confirmation\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Зрозуміла помилка\", function () { const e = pm.response.json().error; pm.expect(e.message).to.be.a(\"string\").and.not.empty; pm.expect(e).to.have.property(\"details\"); });",
                  "pm.test(\"Помилки полів\", function () { const d = pm.response.json().error.details; pm.expect(d).to.have.property(\"username\"); pm.expect(d).to.have.property(\"email\"); pm.expect(d).to.have.property(\"password\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Реєстрація — 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/register/",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"first_name\": \"\",\n  \"last_name\": \"\",\n  \"email\": \"{{username}}@example.com\",\n  \"password\": \"{{password}}\",\n  \"password_confirmation\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"username\", pm.variables.replaceIn(\"postman_{{$guid}}\"));",
                  "pm.collectionVariables.unset(\"access\");",
                  "pm.collectionVariables.unset(\"refresh\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Паролі не повертаються\", function () { const u = pm.response.json(); pm.expect(u).not.to.have.property(\"password\"); pm.expect(u).not.to.have.property(\"password_confirmation\"); });"
                ]
              }
            }
          ]
        },
